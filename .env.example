# Copy to .env.local and fill in. Never commit the real file.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Without it the app still works, using the rule engine only.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: models to try, in order, if the main one is overloaded
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash

# Optional: proxies in front of the app that append to X-Forwarded-For.
# 1 is right for Vercel and Cloud Run; use 2 behind an extra load balancer.
# TRUSTED_PROXY_HOPS=1
